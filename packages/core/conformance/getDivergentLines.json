{
  "schema": 1,
  "function": "getDivergentLines",
  "cases": [
    {
      "name": "identical",
      "args": [
        "a\nb",
        "a\nb"
      ],
      "expected": []
    },
    {
      "name": "one line changed",
      "args": [
        "a\nX\nc",
        "a\nb\nc"
      ],
      "expected": [
        1
      ]
    },
    {
      "name": "frontmatter shifts document indices",
      "args": [
        "---\ntitle: x\ntags: [a]\n---\na\nX",
        "a\nb"
      ],
      "expected": [
        5
      ]
    },
    {
      "name": "missing lines at the end mark the last line",
      "args": [
        "a",
        "a\nb\nc"
      ],
      "expected": [
        0
      ]
    },
    {
      "name": "leading blank lines shift indices",
      "args": [
        "\n\na\nX",
        "a\nb"
      ],
      "expected": [
        3
      ]
    },
    {
      "name": "inserted line in the middle",
      "args": [
        "a\nNEW\nb\nc\nd",
        "a\nb\nc\nd"
      ],
      "expected": [
        1
      ]
    },
    {
      "name": "deleted line marks the line after the gap",
      "args": [
        "a\nc\nd",
        "a\nb\nc\nd"
      ],
      "expected": [
        1
      ]
    },
    {
      "name": "changed first line before an equal line",
      "args": [
        "a\nb",
        "b\nb"
      ],
      "expected": [
        0
      ]
    },
    {
      "name": "tie: drop before add",
      "args": [
        "a\na\nb",
        "c\na"
      ],
      "expected": [
        0,
        2
      ]
    },
    {
      "name": "changed line next to a missing line",
      "args": [
        "a\nX\nc",
        "a\nb\nc\nd"
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "name": "empty current marks nothing",
      "args": [
        "",
        "a"
      ],
      "expected": []
    },
    {
      "name": "inserted line behind frontmatter",
      "args": [
        "---\ntitle: x\ntags: [a]\n---\na\nNEW\nb",
        "a\nb"
      ],
      "expected": [
        5
      ]
    }
  ]
}
