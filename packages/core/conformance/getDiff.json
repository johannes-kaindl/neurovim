  "cases": [
    {
      "name": "identical",
      "args": [
        "a\nb",
        "a\nb"
      ],
      "expected": {
        "matches": true,
        "first_divergent_line": -1,
        "lines_off": 0
      }
    },
    {
      "name": "trailing whitespace only",
      "args": [
        "a  \nb",
        "a\nb"
      ],
      "expected": {
        "matches": true,
        "first_divergent_line": -1,
        "lines_off": 0
      }
    },
    {
      "name": "host frontmatter added",
